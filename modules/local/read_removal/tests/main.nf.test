nextflow_process {

    name "Test Process READ_REMOVAL"
    script "../main.nf"
    process "READ_REMOVAL"
    tag "modules"
    tag "read_removal"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [[id:'test', single_end:true], file("${projectDir}/test_data/read_removal_example.fastq.gz", checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
