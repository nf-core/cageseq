nextflow_process {

    name "Test Process CAGER_PROCESSING"
    script "../main.nf"
    process "CAGER_PROCESSING"
    config "./nextflow.config"

    test("normalise and cluster - BSgenome package") {

        setup {
            run("GTF2TXDB") {
                script "modules/local/gtf2txdb/main.nf"
                process {
                    """
                    input[0] = file(params.pipelines_testdata_base_path + "cageseq/reference/chr_sub.gtf", checkIfExists: true)
                    """
                }
            }
            run("CAGER_READIN") {
                script "modules/local/cager/readin/main.nf"
                process {
                    """
                    def bw_str1 = file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bigwig/test_S2.RPKM.bw", checkIfExists: true)
                    def bw_str2 = file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bigwig/test_S3.RPKM.bw", checkIfExists: true)
                    input[0] = []
                    input[1] = "BSgenome.Hsapiens.UCSC.GRCh37"
                    input[2] = "[cage1, true, \${bw_str1.name}, \${bw_str2.name}, cage1]"
                    input[3] = "bigwig"
                    input[4] = [bw_str1, bw_str2]
                    """
                }
            }
            run("CAGER_TAG_QC") {
                script "modules/local/cager/tag_qc/main.nf"
                process {
                    """
                    input[0] = CAGER_READIN.out.rds[0]
                    input[1] = GTF2TXDB.out.txdb[0]
                    input[2] = []
                    input[3] = "BSgenome.Hsapiens.UCSC.GRCh37"
                    """
                }
            }
        }

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = CAGER_TAG_QC.out.cager_rds[0]
                input[1] = []
                input[2] = "BSgenome.Hsapiens.UCSC.GRCh37"
                input[3] = GTF2TXDB.out.txdb[0]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.rds[0] != null },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("stub") {

        options "-stub"

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = file("dummy.rds")
                input[1] = []
                input[2] = "BSgenome.Hsapiens.UCSC.GRCh37"
                input[3] = file("dummy.sqlite")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
