nextflow_process {

    name "Test Process CAGER_REPORT"
    script "../main.nf"
    process "CAGER_REPORT"

    tag "modules"
    tag "cager_report"

    config "./nextflow.config"

    test("hsapiens - full pipeline output") {

        setup {
            run("CAGER_TAG_QC") {
                script "modules/local/cager/tag_qc/main.nf"
                process {
                    """
                    input[0] = file(params.pipelines_testdata_base_path + '/testdata/v2/intermediate_cagerobj/initial_cagexp.rds')
                    input[1] = file(params.pipelines_testdata_base_path + '/testdata/v2/txdb/annotation_from_gtf.sqlite')
                    input[2] = []
                    input[3] = "BSgenome.Hsapiens.UCSC.GRCh37"
                    """
                }
            }
            run("CAGER_PROCESSING") {
                script "modules/local/cager/processing/main.nf"
                process {
                    """
                    input[0] = CAGER_TAG_QC.out.cager_rds[0]
                    input[1] = []
                    input[2] = "BSgenome.Hsapiens.UCSC.GRCh37"
                    input[3] = file(params.pipelines_testdata_base_path + '/testdata/v2/txdb/annotation_from_gtf.sqlite')
                    """
                }
            }
            run("CAGER_TAGCLUSTER_QC") {
                script "modules/local/cager/tagcluster_qc/main.nf"
                process {
                    """
                    input[0] = CAGER_PROCESSING.out.rds[0]
                    input[1] = file(params.pipelines_testdata_base_path + '/testdata/v2/txdb/annotation_from_gtf.sqlite')
                    input[2] = []
                    input[3] = "BSgenome.Hsapiens.UCSC.GRCh37"
                    """
                }
            }
            run("CAGEFIGHTR_ENHANCERCALLING") {
                script "modules/local/cagefightr/enhancercalling/main.nf"
                process {
                    """
                    input[0] = CAGER_PROCESSING.out.rds[0]
                    input[1] = file(params.pipelines_testdata_base_path + '/testdata/v2/txdb/annotation_from_gtf.sqlite')
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CAGER_TAG_QC.out.plots
                input[1] = CAGER_TAG_QC.out.correlation_rds
                input[2] = CAGER_PROCESSING.out.results
                input[3] = CAGER_TAGCLUSTER_QC.out.plots
                input[4] = CAGER_TAGCLUSTER_QC.out.correlation_rds
                input[5] = CAGEFIGHTR_ENHANCERCALLING.out.plots
                input[6] = CAGER_PROCESSING.out.rds
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
