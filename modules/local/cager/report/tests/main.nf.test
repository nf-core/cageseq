nextflow_process {

    name "Test Process CAGER_REPORT"
    script "../main.nf"
    process "CAGER_REPORT"
    config "./nextflow.config"

    test("stub") {

        options "-stub"

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.Rmd")
                input[1] = [file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds"), file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")]
                input[2] = file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")
                input[3] = [file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds"), file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds"), file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")]
                input[4] = [file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds"), file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")]
                input[5] = file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")
                input[6] = [file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds"), file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")]
                input[7] = file("${projectDir}/modules/local/cager/report/tests/fixtures/dummy.rds")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
