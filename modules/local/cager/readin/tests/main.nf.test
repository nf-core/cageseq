nextflow_process {

    name "Test Process CAGER_READIN"
    script "../main.nf"
    process "CAGER_READIN"

    tag "modules"
    tag "cager_readin"

    test("hsapiens - bigwig - BSgenome package - single_end") {

        when {
            process {
                """
                def bw_str1 = file(params.pipelines_testdata_base_path + '/testdata/v2/bigwig/S1.Signal.Unique.str1.out.wig.bw', checkIfExists: true)
                def bw_str2 = file(params.pipelines_testdata_base_path + '/testdata/v2/bigwig/S1.Signal.Unique.str2.out.wig.bw', checkIfExists: true)
                input[0] = file(params.pipelines_testdata_base_path + '/reference/v2/BSgenome.sacCer3ChrIII.Test.sacCer3ChrIII_1.0.tar.gz')
                input[1] = ""
                input[2] = "[S1, false, \${bw_str1.name}, \${bw_str2.name} , S1]"
                input[3] = "bigwig"
                input[4] = [bw_str1, bw_str2]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.rds.size() == 1 },
                { assert file(process.out.rds[0]).name.endsWith('.rds') },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("hsapiens - bigwig - BSgenome package - single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = []
                input[1] = "BSgenome.Hsapiens.UCSC.hg38"
                input[2] = "[cage1, false, cage1.str1.bw, ,cage1]"
                input[3] = "bigwig"
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
