nextflow_process {

    name "Test Process CAGER_TAG_QC"
    script "../main.nf"
    process "CAGER_TAG_QC"

    tag "modules"
    tag "cager_tag_qc"

    config "./nextflow.config"

    test("hsapiens - cagerobj - BSgenome package") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/testdata/v2/intermediate_cagerobj/initial_cagexp.rds')
                input[1] = file(params.pipelines_testdata_base_path + '/testdata/v2/txdb/annotation_from_gtf.sqlite')
                input[2] = file(params.pipelines_testdata_base_path + '/reference/v2/BSgenome.sacCer3ChrIII.Test.sacCer3ChrIII_1.0.tar.gz')
                input[3] = ""
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.cager_rds.size() == 1 },
                { assert process.out.correlation_rds.size() == 1 },
                { assert process.out.plots.size() == 1 },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("hsapiens - cagerobj - BSgenome package - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/testdata/v2/intermediate_cagerobj/initial_cagexp.rds')
                input[1] = file(params.pipelines_testdata_base_path + '/testdata/v2/txdb/annotation_from_gtf.sqlite')
                input[2] = file(params.pipelines_testdata_base_path + '/reference/v2/BSgenome.sacCer3ChrIII.Test.sacCer3ChrIII_1.0.tar.gz')
                input[3] = ""
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
