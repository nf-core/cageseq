nextflow_process {

    name "Test Process GTF2TXDB"
    script "../main.nf"
    process "GTF2TXDB"
    tag "modules"
    tag "gtf2txdb"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                outdir = "tests/results"
            }
            process {
                """
                input[0] = file("${projectDir}/test_data/example.gtf", checkIfExists: true)
                // define inputs of the process here. Example:
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
