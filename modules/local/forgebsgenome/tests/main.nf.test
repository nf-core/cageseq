nextflow_process {

    name "Test Process FORGEBSGENOME"
    script "../main.nf"
    process "FORGEBSGENOME"

    tag "modules"
    tag "modules_local"
    tag "forgebsgenome"

    test("sarscov2 - forge_seed") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = [ [id: 'sarscov2'], file("${projectDir}/modules/local/forgebsgenome/tests/data/sarscov2_seed.txt", checkIfExists: true) ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.tarball.collect { meta, tarball -> [meta.id, tarball.name] }
                ).match() }
            )
        }

    }

    test("sarscov2 - forge_seed - stub") {

        options "-stub"

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = [ [id: 'sarscov2'], file("${projectDir}/modules/local/forgebsgenome/tests/data/sarscov2_seed.txt", checkIfExists: true) ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
