nextflow_pipeline {

    name "Test the full pipeline with some alternative parameters"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir      = "$outputDir"
                unique_only = false
                bowtie2     = true
                // Deduplication works (checked the existence and content of samtools dedup stats files),
                // but on the test datasets signal becomes too low for the subsequent normalisation in CAGEr:
                // Error in .fit.power.law.to.reverse.cumulative(decode(x), val.range) :
                //     Selected range for fitting the power law does not contain any tag count values. Consider changing/increasing 'fitInRange'.
                //  Calls: cager_normalization ... lapply -> FUN -> .fit.power.law.to.reverse.cumulative
                // Therefore, we comment out deduplication params
                // dedup       = true
                // dist        = 100
                datatype    = "bam"
                forgeseed   = params.pipelines_testdata_base_path + "cageseq/reference/v2/BSgenome.sacCer3ChrIII.Test.sacCer3ChrIII-seed"
                sourcedir   = params.pipelines_testdata_base_path + "cageseq/reference/v2/seq_dir"
                bsgenome    = null
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_cageseq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
