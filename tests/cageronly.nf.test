nextflow_pipeline {

    name "Test the CAGEr part of the pipeline with various alternative parameters"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                // insert mandatory input for cageronly
                bsgenome = params.pipelines_testdata_base_path + "cageseq/reference/v2/BSgenome.sacCer3ChrIII.Test.sacCer3ChrIII_1.0.tar.gz"
                fullpipeline = false
                cageronly = true
                corrplot_tagCountThreshold = 2
                norm_range_max = 15000
                t_norm = 100000
                ctss_thr = 2
                distclu_maxDist = 25
                tssregion_up = -2000
                tssregion_down = 2000
                tsslogo_upstream = 25
                consensus_dist = 25
                cfBalanceThreshold = 0.75
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_cageseq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
